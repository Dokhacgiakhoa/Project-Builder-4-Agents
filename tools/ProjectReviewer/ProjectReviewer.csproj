<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Project-Builder-Analytics</AssemblyName>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <RootNamespace>ProjectReviewer</RootNamespace>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\app-icon.ico" Link="app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embed the Core Engine directly into the Shell to produce a single standalone EXE -->
  <ItemGroup Condition="Exists('..\..\engine\reviewer-engine.exe')">
    <EmbeddedResource Include="..\..\engine\reviewer-engine.exe" LogicalName="reviewer-engine.exe" />
  </ItemGroup>

</Project>
